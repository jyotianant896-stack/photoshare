# Copy to .env before running docker compose in anything other than local dev.

MYSQL_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Where the API and the site are reachable from a browser
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# local | s3
STORAGE_TYPE=local
# Only when STORAGE_TYPE=s3
S3_BUCKET=
AWS_REGION=ap-south-1
